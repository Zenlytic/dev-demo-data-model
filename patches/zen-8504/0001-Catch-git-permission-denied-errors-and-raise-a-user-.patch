+
+    @staticmethod
+    def raise_for_git_permission_error(error: git.GitCommandError):
+        """Translate GitPython permission failures (e.g. a deploy key without write access)
+        into a GitPermissionError with a message that is safe to display to the user."""
+        stderr = str(error.stderr or "")
+        permission_denied_indicators = [
+            "denied to deploy key",
+            "Permission denied",
+            "correct access rights",
+            "The requested URL returned error: 403",
+        ]
+        if not any(indicator in stderr for indicator in permission_denied_indicators):
+            return
+
+        match = re.search(r"Permission to ([^\s']+) denied(?: to ([^\n']+))?", stderr)
+        repo_reference = f"the repository {match.group(1)}" if match else "the repository"
+        actor_reference = "the deploy key"
+        if match and match.group(2):
+            actor_reference = match.group(2).strip().rstrip(".'\"")
+            if not actor_reference.startswith("the "):
+                actor_reference = f"the {actor_reference}"
+        message = (
+            f"Permission denied while running git. Access to {repo_reference} was denied to"
+            f" {actor_reference}. Please make sure {actor_reference} has write access and the"
+            " repository exists."
+        )
+        raise GitPermissionError(message) from error
 
     def fetch_github_repo(self, private_key: str):
-        if self.is_ssh:
-            if private_key is None:
-                raise ValueError("Private key is required for SSH mode of connection to Github.")
-            repo, branch_options, file_path = GithubRepo._fetch_github_repo_ssh(
-                self.repo_url, self.repo_destination, self.branch, private_key
-            )
-        else:
-            repo, branch_options = GithubRepo._fetch_github_repo_https(
-                self.repo_url, self.repo_destination, self.branch
-            )
-            file_path = None
+        try:
+            if self.is_ssh:
+                if private_key is None:
+                    raise ValueError("Private key is required for SSH mode of connection to Github.")
+                repo, branch_options, file_path = GithubRepo._fetch_github_repo_ssh(
+                    self.repo_url, self.repo_destination, self.branch, private_key
+                )
+            else:
+                repo, branch_options = GithubRepo._fetch_github_repo_https(
+                    self.repo_url, self.repo_destination, self.branch
+                )
+                file_path = None
+        except git.GitCommandError as e:
+            GithubRepo.raise_for_git_permission_error(e)
+            raise
         return repo, branch_options, file_path
 
     @staticmethod
