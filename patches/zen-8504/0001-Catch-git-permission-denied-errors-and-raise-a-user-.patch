@@ -0,0 +1,85 @@
+import git
+import pytest
+
+from metrics_layer.core.exceptions import GitError, GitPermissionError, MetricsLayerException
+from metrics_layer.core.parse.github_repo import GithubRepo
+
+DEPLOY_KEY_DENIED_STDERR = (
+    "ERROR: Permission to Zenlytic/dev-demo-data-model.git denied to deploy key\n"
+    "fatal: Could not read from remote repository.\n\n"
+    "Please make sure you have the correct access rights\n"
+    "and the repository exists."
+)
+
+
+def _deploy_key_denied_error():
+    return git.GitCommandError(
+        ["git", "push", "origin", "pb-test-2"], status=128, stderr=DEPLOY_KEY_DENIED_STDERR
+    )
+
+
+def test_deploy_key_permission_denied_is_translated():
+    with pytest.raises(GitPermissionError) as exc_info:
+        GithubRepo.raise_for_git_permission_error(_deploy_key_denied_error())
+
+    message = str(exc_info.value)
+    assert "Permission denied" in message
+    assert "Zenlytic/dev-demo-data-model.git" in message
+    assert "deploy key" in message
+    # The raw GitPython formatting should not leak into the user-facing message
+    assert "Cmd('git') failed" not in message
+    assert "exit code(128)" not in message
+    # The exception is catchable via the library's base exception types
+    assert isinstance(exc_info.value, GitError)
+    assert isinstance(exc_info.value, MetricsLayerException)
+
+
+def test_https_403_is_translated():
+    error = git.GitCommandError(
+        ["git", "push", "origin", "main"],
+        status=128,
+        stderr=(
+            "fatal: unable to access 'https://github.com/Zenlytic/dev-demo-data-model/':"
+            " The requested URL returned error: 403"
+        ),
+    )
+    with pytest.raises(GitPermissionError):
+        GithubRepo.raise_for_git_permission_error(error)
+
+
+def test_unrelated_git_error_is_not_translated():
+    error = git.GitCommandError(
+        ["git", "push", "origin", "main"],
+        status=1,
+        stderr="error: failed to push some refs to 'origin' (non-fast-forward)",
+    )
+    # Should return without raising, so the original error propagates unchanged
+    assert GithubRepo.raise_for_git_permission_error(error) is None
+
+
+def test_add_commit_and_push_raises_git_permission_error(monkeypatch):
+    repo = GithubRepo(repo_url="git@github.com:Zenlytic/dev-demo-data-model.git", branch="master")
+    repo._file_path = None
+
+    class FakeGit:
+        def checkout(self, *args, **kwargs):
+            pass
+
+        def add(self, *args, **kwargs):
+            pass
+
+        def commit(self, *args, **kwargs):
+            pass
+
+        def push(self, *args, **kwargs):
+            raise _deploy_key_denied_error()
+
+    class FakeRepo:
+        git = FakeGit()
+
+    repo.git_repo = FakeRepo()
+
+    with pytest.raises(GitPermissionError) as exc_info:
+        repo.add_commit_and_push(message="test commit", branch_name="pb-test-2")
+
+    assert "Zenlytic/dev-demo-data-model.git" in str(exc_info.value)
